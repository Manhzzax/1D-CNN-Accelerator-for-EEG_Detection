{
  "version": "v2.1.0",
  "claim_scope": "shared_model_within_patient_forward_chaining",
  "dataset": {
    "name": "CHB-MIT Scalp EEG Database v1.0.0",
    "sample_rate_hz": 256,
    "canonical_channels": 17,
    "case_ids": 24,
    "patient_groups": 23
  },
  "preprocessing": {
    "filter_mode": "causal_iir",
    "bandpass_hz": [0.5, 45.0],
    "notch_hz": 60.0,
    "normalization": "train_channel_zscore",
    "window_sec": 5.0,
    "stride_sec": 1.0,
    "interictal_guard_sec": 30.0
  },
  "labels": {
    "rule": "causal_window_endpoint",
    "interval_convention": "half_open_samples",
    "classifier_guard_policy": "exclude_nonictal_endpoints_within_guard",
    "continuous_event_replay": "all_windows_no_guard_removal"
  },
  "window_sampling": {
    "normal_to_positive_ratio": {"train": 1.0, "val": 1.0, "temporal_eval": 1.0, "test": 1.0}
  },
  "split": {
    "strategy": "patient_group_cumulative_duration_forward_chaining",
    "base_block_count": 7,
    "confirmation_folds": 3,
    "confirmation_layout": "F00=train_0_calibration_1_evaluation_2;F01=train_0_1_calibration_2_evaluation_3;F02=train_0_1_2_calibration_3_evaluation_4",
    "final_layout": "train_0_to_4_calibration_5_sealed_test_6",
    "final_test_status": "sealed_until_final_freeze",
    "patient_grouping": {
      "case_to_patient_group": {"chb01": "subject_01_21", "chb21": "subject_01_21"},
      "session_order": {"subject_01_21": ["chb01", "chb21"]},
      "session_order_evidence": "EDF acquisition timestamps, then recording_order_in_case"
    },
    "feasibility_gate": {
      "minimum_union_seizures": 20,
      "minimum_seizure_contributing_patient_groups": 5,
      "minimum_nonictal_replay_hours": 24.0
    }
  },
  "training": {
    "training_seeds": [7, 42, 123, 314, 2718],
    "deployment_export_seed": 42,
    "dataset_sampling_seed": 20260802,
    "precision": "amp_fp16_train_fp32_evaluate",
    "max_epochs": 50,
    "min_epochs": 12,
    "early_stopping_patience": 12,
    "early_stopping_min_delta": 0.001,
    "frozen_candidates": {
      "B0_bandpower_linear": {"architecture": "v2_bandpower_linear", "learning_rate": 0.001, "weight_decay": 0.0001, "seeds": [42], "role": "sanity_baseline"},
      "B1_vanilla_1dcnn": {"architecture": "v2_vanilla_1dcnn", "learning_rate": 0.001, "weight_decay": 0.0005, "seeds": [42], "role": "sanity_baseline"},
      "B2_deep_matched_1dcnn": {"architecture": "v2_deep_matched_1dcnn", "learning_rate": 0.0003, "weight_decay": 0.0005, "seeds": [7, 42, 123, 314, 2718], "role": "clinical_candidate"},
      "B4_dilated_lightseizure_like": {"architecture": "dilated_hierarchical_separable_1dcnn", "learning_rate": 0.001, "weight_decay": 0.0005, "seeds": [7, 42, 123, 314, 2718], "role": "clinical_candidate"}
    }
  },
  "evaluation": {
    "window_primary_metrics": ["balanced_accuracy", "auroc"],
    "report_accuracy_on": "explicitly_balanced_1_to_1_windows_only",
    "primary_far_per_hour": 0.5,
    "report_far_per_hour": [0.1, 0.5, 1.0],
    "refractory_sec": 30,
    "threshold_grid": {"minimum": 0.85, "maximum": 0.999, "step": 0.001},
    "temporal_policies": [[3, 6], [4, 8], [5, 10], [6, 12], [7, 14], [8, 16], [9, 18], [10, 20]],
    "calibration_rule": "maximize_sensitivity_subject_to_observed_calibration_far_at_or_below_target",
    "confidence_interval": "patient_group_cluster_bootstrap_10000_and_poisson_exact_far",
    "selection_rule": "clinical_first_event_sensitivity_with_fold_consistency_then_pareto"
  },
  "hardware": {
    "quantization_primary": "symmetric_int16_weights_activations_int32_bias_accumulator",
    "activation_scale_calibration": "final_train_only",
    "input_layout": "NCT",
    "input_shape": [1, 17, 1280],
    "dpu_audit_before_hls": true,
    "hardware_implementation_after_model_freeze": true
  }
}
